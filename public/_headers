# Cloudflare Pages reads this from the build output root.

# Vite fingerprints these filenames, so the content behind a given URL can never
# change. Cache them for a year and never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep stable filenames, so they must stay revalidatable — otherwise
# swapping a dessert photo would leave the old one cached for a year.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
